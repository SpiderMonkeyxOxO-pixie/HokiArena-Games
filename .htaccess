# Block public access to build/deploy source files (information-disclosure fix).
# These should never be served; they expose live affiliate tracking codes.
<FilesMatch "\.(py|ini)$">
  Require all denied
</FilesMatch>

# Consolidate www -> apex domain.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.hokiarena\.games$ [NC]
  RewriteRule ^(.*)$ https://hokiarena.games/$1 [L,R=301]
</IfModule>

# Baseline security headers.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'self'"
</IfModule>
